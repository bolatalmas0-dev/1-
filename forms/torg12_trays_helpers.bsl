#Область ТОРГ12ЛоткиПроба

// Для исходной сетки присланного MXL. Исходные строки документа не изменяются.
// ОКЕИ: колонка 6; лотки: 8; количество: 11. Номер товарной строки: 2.
Процедура ТОРГ12ЛоткиПослеПечати(ТабДокТОРГ12)

	ИзмененияТОРГ12 = Новый Массив;
	ПрименениеНачалосьТОРГ12 = Ложь;
	ШапкаНайденаТОРГ12 = Ложь;
	КгСтрокТОРГ12 = 0;
	ВсегоСтрокТОРГ12 = 0;
	ИтоговДокТОРГ12 = 0;
	СтарыйИтогСтраницыТОРГ12 = 0;
	НовыйИтогСтраницыТОРГ12 = 0;
	СтрокСтраницыТОРГ12 = 0;
	СтарыйИтогДокТОРГ12 = 0;
	НовыйИтогДокТОРГ12 = 0;
	СтрокДокТОРГ12 = 0;

	Попытка

		// Сначала проверяем всю таблицу и собираем изменения без записи.
		Для РядТОРГ12 = 1 По ТабДокТОРГ12.ВысотаТаблицы Цикл

			Текст6ТОРГ12 = ТОРГ12ЛоткиТекст(ТабДокТОРГ12.Область(РядТОРГ12, 6).Текст);
			Текст7ТОРГ12 = ТОРГ12ЛоткиТекст(ТабДокТОРГ12.Область(РядТОРГ12, 7).Текст);
			Текст8ТОРГ12 = ТОРГ12ЛоткиТекст(ТабДокТОРГ12.Область(РядТОРГ12, 8).Текст);
			Текст11ТОРГ12 = ТабДокТОРГ12.Область(РядТОРГ12, 11).Текст;

			Если ТОРГ12ЛоткиТекст(Текст11ТОРГ12) = "количество(кг/шт)" Тогда
				ИзмененияТОРГ12.Добавить(Новый Структура("Ряд,Колонка,Текст", РядТОРГ12, 11,
					"Количество" + Символы.ПС + "лотков / шт"));
			КонецЕсли;

			Если СтрНайти(Текст6ТОРГ12, "океи") > 0
				И СтрНайти(Текст8ТОРГ12, "лот") > 0 Тогда
				ШапкаНайденаТОРГ12 = Истина;
				Продолжить;
			КонецЕсли;

			Если Не ШапкаНайденаТОРГ12 Тогда
				Продолжить;
			КонецЕсли;

			Если Текст7ТОРГ12 = "итогопонакладной" И СтрокДокТОРГ12 > 0 Тогда
				ТОРГ12ЛоткиПроверитьИтог(Текст11ТОРГ12, СтарыйИтогДокТОРГ12, СтрокДокТОРГ12);
				ИзмененияТОРГ12.Добавить(Новый Структура("Ряд,Колонка,Текст", РядТОРГ12, 11,
					Формат(НовыйИтогДокТОРГ12, "ЧДЦ=3; ЧГ=0; ЧН=0")));
				ИтоговДокТОРГ12 = ИтоговДокТОРГ12 + 1;
				СтарыйИтогДокТОРГ12 = 0;
				НовыйИтогДокТОРГ12 = 0;
				СтрокДокТОРГ12 = 0;
				СтарыйИтогСтраницыТОРГ12 = 0;
				НовыйИтогСтраницыТОРГ12 = 0;
				СтрокСтраницыТОРГ12 = 0;
				Продолжить;
			КонецЕсли;

			Если (Текст8ТОРГ12 = "итого" Или Текст8ТОРГ12 = "итогопостранице")
				И СтрокСтраницыТОРГ12 > 0 Тогда
				ТОРГ12ЛоткиПроверитьИтог(Текст11ТОРГ12, СтарыйИтогСтраницыТОРГ12, СтрокСтраницыТОРГ12);
				ИзмененияТОРГ12.Добавить(Новый Структура("Ряд,Колонка,Текст", РядТОРГ12, 11,
					Формат(НовыйИтогСтраницыТОРГ12, "ЧДЦ=3; ЧГ=0; ЧН=0")));
				СтарыйИтогСтраницыТОРГ12 = 0;
				НовыйИтогСтраницыТОРГ12 = 0;
				СтрокСтраницыТОРГ12 = 0;
				Продолжить;
			КонецЕсли;

			Если Текст6ТОРГ12 <> "166" И Текст6ТОРГ12 <> "796" Тогда
				Продолжить;
			КонецЕсли;
			НомерТовараТОРГ12 = ТОРГ12ЛоткиЧисло(ТабДокТОРГ12.Область(РядТОРГ12, 2).Текст);
			Если НомерТовараТОРГ12 = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СтароеКоличествоТОРГ12 = ТОРГ12ЛоткиЧисло(Текст11ТОРГ12);
			Если СтароеКоличествоТОРГ12 = Неопределено Тогда
				ВызватьИсключение "Не прочитано количество в товарной строке.";
			КонецЕсли;
			НовоеКоличествоТОРГ12 = СтароеКоличествоТОРГ12;

			Если Текст6ТОРГ12 = "166" Тогда
				ТекстЛотковТОРГ12 = СокрЛП(ТабДокТОРГ12.Область(РядТОРГ12, 8).Текст);
				НовоеКоличествоТОРГ12 = ТОРГ12ЛоткиЧисло(ТекстЛотковТОРГ12);
				Если НовоеКоличествоТОРГ12 = Неопределено Тогда
					ВызватьИсключение "Не прочитано число лотков у товара в кг.";
				КонецЕсли;
				Если СтароеКоличествоТОРГ12 <> 0 И НовоеКоличествоТОРГ12 = 0 Тогда
					ВызватьИсключение "У непустой строки в кг напечатано ноль лотков.";
				КонецЕсли;
				ИзмененияТОРГ12.Добавить(Новый Структура("Ряд,Колонка,Текст", РядТОРГ12, 11,
					ТекстЛотковТОРГ12));
				КгСтрокТОРГ12 = КгСтрокТОРГ12 + 1;
			КонецЕсли;

			СтарыйИтогСтраницыТОРГ12 = СтарыйИтогСтраницыТОРГ12 + СтароеКоличествоТОРГ12;
			НовыйИтогСтраницыТОРГ12 = НовыйИтогСтраницыТОРГ12 + НовоеКоличествоТОРГ12;
			СтрокСтраницыТОРГ12 = СтрокСтраницыТОРГ12 + 1;
			СтарыйИтогДокТОРГ12 = СтарыйИтогДокТОРГ12 + СтароеКоличествоТОРГ12;
			НовыйИтогДокТОРГ12 = НовыйИтогДокТОРГ12 + НовоеКоличествоТОРГ12;
			СтрокДокТОРГ12 = СтрокДокТОРГ12 + 1;
			ВсегоСтрокТОРГ12 = ВсегоСтрокТОРГ12 + 1;

		КонецЦикла;

		Если Не ШапкаНайденаТОРГ12 Тогда
			ВызватьИсключение "Не найден заголовок ОКЕИ/лотков в ожидаемых колонках макета.";
		КонецЕсли;
		Если КгСтрокТОРГ12 = 0 Тогда
			Возврат;
		КонецЕсли;
		Если ИтоговДокТОРГ12 = 0 Или СтрокДокТОРГ12 <> 0 Тогда
			ВызватьИсключение "Не найдены соответствующие итоги накладной в этом макете.";
		КонецЕсли;

		// Сохраняем исходные ячейки для отката при ошибке записи.
		Для Каждого ПравкаТОРГ12 Из ИзмененияТОРГ12 Цикл
			ЯчейкаТОРГ12 = ТабДокТОРГ12.Область(ПравкаТОРГ12.Ряд, ПравкаТОРГ12.Колонка);
			ПравкаТОРГ12.Вставить("ПрежнийТекст", ЯчейкаТОРГ12.Текст);
			ПравкаТОРГ12.Вставить("ПрежнийРежимЗначения", ЯчейкаТОРГ12.СодержитЗначение);
			ПравкаТОРГ12.Вставить("ПрежнееЗначение", Неопределено);
			Если ЯчейкаТОРГ12.СодержитЗначение Тогда
				ПравкаТОРГ12.ПрежнееЗначение = ЯчейкаТОРГ12.Значение;
			КонецЕсли;
		КонецЦикла;

		ПрименениеНачалосьТОРГ12 = Истина;
		Для Каждого ПравкаТОРГ12 Из ИзмененияТОРГ12 Цикл
			ЯчейкаТОРГ12 = ТабДокТОРГ12.Область(ПравкаТОРГ12.Ряд, ПравкаТОРГ12.Колонка);
			ЯчейкаТОРГ12.СодержитЗначение = Ложь;
			ЯчейкаТОРГ12.Текст = ПравкаТОРГ12.Текст;
		КонецЦикла;
		СообщениеТОРГ12 = Новый СообщениеПользователю;
		СообщениеТОРГ12.Текст = "ТОРГ12-ЛОТКИ: изменено строк в кг: " + Строка(КгСтрокТОРГ12)
			+ "; учтено товарных строк: " + Строка(ВсегоСтрокТОРГ12) + ".";
		СообщениеТОРГ12.Сообщить();

	Исключение

		ТекстОшибкиТОРГ12 = "ТОРГ12-ЛОТКИ: пробная правка не применена. " + ОписаниеОшибки();
		Если ПрименениеНачалосьТОРГ12 Тогда
			Попытка
				Для Каждого ПравкаТОРГ12 Из ИзмененияТОРГ12 Цикл
					ЯчейкаТОРГ12 = ТабДокТОРГ12.Область(ПравкаТОРГ12.Ряд, ПравкаТОРГ12.Колонка);
					ЯчейкаТОРГ12.СодержитЗначение = ПравкаТОРГ12.ПрежнийРежимЗначения;
					Если ПравкаТОРГ12.ПрежнийРежимЗначения Тогда
						ЯчейкаТОРГ12.Значение = ПравкаТОРГ12.ПрежнееЗначение;
					Иначе
						ЯчейкаТОРГ12.Текст = ПравкаТОРГ12.ПрежнийТекст;
					КонецЕсли;
				КонецЦикла;
			Исключение
				ТекстОшибкиТОРГ12 = ТекстОшибкиТОРГ12
					+ " Восстановление ячеек не завершено: удалите вызов пробы и сформируйте печать заново.";
			КонецПопытки;
		КонецЕсли;
		СообщениеТОРГ12 = Новый СообщениеПользователю;
		СообщениеТОРГ12.Текст = ТекстОшибкиТОРГ12;
		СообщениеТОРГ12.Сообщить();

	КонецПопытки;

КонецПроцедуры

// Проверка исходного итога предотвращает подмену неполной суммы строк.
Процедура ТОРГ12ЛоткиПроверитьИтог(ТекстИтогаТОРГ12, ОжидаемыйИтогТОРГ12, СтрокТОРГ12)
	ИтогТОРГ12 = ТОРГ12ЛоткиЧисло(ТекстИтогаТОРГ12);
	Если ИтогТОРГ12 = Неопределено Тогда
		ВызватьИсключение "Не прочитан исходный итог количества.";
	КонецЕсли;
	РазницаТОРГ12 = ИтогТОРГ12 - ОжидаемыйИтогТОРГ12;
	ДопускТОРГ12 = (СтрокТОРГ12 + 1) * 0.0005;
	Если РазницаТОРГ12 > ДопускТОРГ12 Или РазницаТОРГ12 < -ДопускТОРГ12 Тогда
		ВызватьИсключение "Исходный итог отличается от распознанных строк: нужна проверка разметки или других единиц.";
	КонецЕсли;
КонецПроцедуры

Функция ТОРГ12ЛоткиТекст(ТекстТОРГ12)
	РезультатТОРГ12 = НРег(СокрЛП(ТекстТОРГ12));
	РезультатТОРГ12 = СтрЗаменить(РезультатТОРГ12, " ", "");
	РезультатТОРГ12 = СтрЗаменить(РезультатТОРГ12, Символ(160), "");
	РезультатТОРГ12 = СтрЗаменить(РезультатТОРГ12, Символ(8239), "");
	РезультатТОРГ12 = СтрЗаменить(РезультатТОРГ12, Символ(8201), "");
	РезультатТОРГ12 = СтрЗаменить(РезультатТОРГ12, Символы.ПС, "");
	РезультатТОРГ12 = СтрЗаменить(РезультатТОРГ12, Символы.ВК, "");
	Возврат РезультатТОРГ12;
КонецФункции

// Читаем цифры, запятую/точку без зависимости от регионального разделителя.
Функция ТОРГ12ЛоткиЧисло(ТекстТОРГ12)
	ТекстЧислаТОРГ12 = ТОРГ12ЛоткиТекст(ТекстТОРГ12);
	Если ПустаяСтрока(ТекстЧислаТОРГ12) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЗнакТОРГ12 = 1;
	Если Лев(ТекстЧислаТОРГ12, 1) = "-" Тогда
		ЗнакТОРГ12 = -1;
		ТекстЧислаТОРГ12 = Сред(ТекстЧислаТОРГ12, 2);
	ИначеЕсли Лев(ТекстЧислаТОРГ12, 1) = "+" Тогда
		ТекстЧислаТОРГ12 = Сред(ТекстЧислаТОРГ12, 2);
	КонецЕсли;
	ЗначениеТОРГ12 = 0;
	ДелительТОРГ12 = 1;
	ЕстьЦифраТОРГ12 = Ложь;
	ПослеРазделителяТОРГ12 = Ложь;
	Для ПозицияТОРГ12 = 1 По СтрДлина(ТекстЧислаТОРГ12) Цикл
		СимволТОРГ12 = Сред(ТекстЧислаТОРГ12, ПозицияТОРГ12, 1);
		Если СимволТОРГ12 = "," Или СимволТОРГ12 = "." Тогда
			Если ПослеРазделителяТОРГ12 Тогда
				Возврат Неопределено;
			КонецЕсли;
			ПослеРазделителяТОРГ12 = Истина;
		Иначе
			ЦифраТОРГ12 = СтрНайти("0123456789", СимволТОРГ12) - 1;
			Если ЦифраТОРГ12 < 0 Тогда
				Возврат Неопределено;
			КонецЕсли;
			ЕстьЦифраТОРГ12 = Истина;
			ЗначениеТОРГ12 = ЗначениеТОРГ12 * 10 + ЦифраТОРГ12;
			Если ПослеРазделителяТОРГ12 Тогда
				ДелительТОРГ12 = ДелительТОРГ12 * 10;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Не ЕстьЦифраТОРГ12 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ЗнакТОРГ12 * ЗначениеТОРГ12 / ДелительТОРГ12;
КонецФункции

#КонецОбласти
