
			// ТОРГ-12: масса весовых товаров из количества в печатных кг.
			Для Каждого ДанныеДокументаТОРГ12 Из ДанныеОбъектовПечати Цикл

				ЕстьКилограммыТОРГ12 = Ложь;
				ВсеМассыЗаполненыТОРГ12 = Истина;
				МассаДокументаТОРГ12 = 0;

				Для Каждого СтрокаЗапасаТОРГ12 Из ДанныеДокументаТОРГ12.ТаблицаЗапасы Цикл

					Если СтрокаЗапасаТОРГ12.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Запас Тогда
						Продолжить;
					КонецЕсли;

					КодОКЕИТОРГ12 = СокрЛП(Строка(СтрокаЗапасаТОРГ12.ЕдиницаИзмеренияПоОКЕИ_Код));
					Если КодОКЕИТОРГ12 = "166" Тогда
						СтрокаЗапасаТОРГ12.МассаБрутто = СтрокаЗапасаТОРГ12.Количество
							* СтрокаЗапасаТОРГ12.КоэффициентЕдиницыИзмерения;
						ЕстьКилограммыТОРГ12 = Истина;
					КонецЕсли;

					Если СтрокаЗапасаТОРГ12.КоличествоМест <> 0
						И СтрокаЗапасаТОРГ12.МассаБрутто = 0 Тогда
						// Нулевой вес непустой строки не подтверждает полный вес груза.
						ВсеМассыЗаполненыТОРГ12 = Ложь;
					КонецЕсли;

					МассаДокументаТОРГ12 = МассаДокументаТОРГ12 + СтрокаЗапасаТОРГ12.МассаБрутто;

				КонецЦикла;

				Если ЕстьКилограммыТОРГ12 И ВсеМассыЗаполненыТОРГ12 Тогда
					ДанныеДокументаТОРГ12.Вес = МассаДокументаТОРГ12;
				КонецЕсли;

			КонецЦикла;
